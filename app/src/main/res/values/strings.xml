    <string name="onboard_title">Welcome to Squeeze</string>
    <string name="onboard_intro">Squeeze works fully on your phone. Nothing here is required to start, but these let it do more. You can change any of them later in Settings.</string>
    <string name="onboard_continue">Continue</string>
