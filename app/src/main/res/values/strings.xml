    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">Batch video compression for Android, powered by FFmpeg.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">Squeeze works entirely on your phone. It has no internet permission, no accounts, no analytics and sends nothing anywhere. Your videos are only read to compress them, and results are written where you choose.</string>
