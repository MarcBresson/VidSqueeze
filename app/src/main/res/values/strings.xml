    <string name="perm_allow">Allow</string>
    <string name="perm_app_settings">App settings</string>
    <string name="perm_open_settings">Open system settings</string>
    <string name="perm_videos">Your videos</string>
    <string name="perm_videos_why">Lets Squeeze find old and heavy videos, compress them where they are and replace the originals. Sharing and picking videos works without it.</string>
    <string name="perm_location">Location in videos</string>
    <string name="perm_location_why">Lets "keep location" preserve the place a video was filmed. Without it the location is dropped.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Shows progress while compressing and the actions for finished videos (reshare, replace, save).</string>
    <string name="perm_manage_media">Replace without asking</string>
    <string name="perm_manage_media_why">Special access so replacing originals does not ask each time. Needed to replace originals during automatic compression; otherwise results wait for you in the Ready list.</string>
    <string name="perm_battery">Battery optimisation</string>
    <string name="perm_battery_why">Some phones stop long background work. Setting Squeeze to "Unrestricted" or "Not optimised" helps overnight compression finish.</string>

